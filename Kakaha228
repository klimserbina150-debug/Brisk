-- Silent Aim
local function IsVisible(targetChar)
    local myChar = LP.Character
    if not myChar then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar, targetChar, Cam}
    local targetPart = targetChar:FindFirstChild(Vars.SilentAimTargetPart) or targetChar:FindFirstChild("HumanoidRootPart")
    if not targetPart then return false end
    local res = workspace:Raycast(Cam.CFrame.Position, (targetPart.Position - Cam.CFrame.Position), params)
    return res == nil
end

local function GetTarget()
    local closest, shortest = nil, Vars.SilentAimFov
    local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local targetPart = p.Character:FindFirstChild(Vars.SilentAimTargetPart) or p.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local dist = (Cam.CFrame.Position - targetPart.Position).Magnitude
                    if dist <= Vars.SilentAimMaxDist then
                        if Vars.SilentAimVisibleCheck and not IsVisible(p.Character) then
                            -- пропускаем
                        else
                            local pos, onScreen = Cam:WorldToViewportPoint(targetPart.Position)
                            if onScreen then
                                local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                if d < shortest then shortest = d; closest = targetPart end
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

