-- ESP
local ESP_Data = {}
local function MakeESP(p)
    if p == LP then return end
    if ESP_Data[p] then
        for _, d in pairs(ESP_Data[p]) do pcall(function() d:Remove() end) end
    end
    local okD, data = pcall(function()
        return {
            Box = Drawing.new("Square"),
            Name = Drawing.new("Text"),
            Health = Drawing.new("Square"),
        }
    end)
    if not okD or not data then return end
    data.Box.Visible = false; data.Box.Thickness = 1; data.Box.Color = Color3.fromRGB(255,0,0); data.Box.Filled = false
    data.Name.Visible = false; data.Name.Size = 14; data.Name.Center = true; data.Name.Outline = true; data.Name.Color = Color3.new(1,1,1)
    data.Health.Visible = false; data.Health.Thickness = 1; data.Health.Filled = true
    ESP_Data[p] = data
end

for _, p in ipairs(Players:GetPlayers()) do pcall(MakeESP, p) end
Players.PlayerAdded:Connect(function(p) pcall(MakeESP, p) end)
Players.PlayerRemoving:Connect(function(p)
    if ESP_Data[p] then
        for _, d in pairs(ESP_Data[p]) do pcall(function() d:Remove() end) end
        ESP_Data[p] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    pcall(function()
        for p, data in pairs(ESP_Data) do
            if Vars.ESPEnabled and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Head") then
                local hrp = p.Character.HumanoidRootPart
                local head = p.Character.Head
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local dist = (Cam.CFrame.Position - hrp.Position).Magnitude
                if dist <= Vars.ESPMaxDist then
                    local pos, onScreen = Cam:WorldToViewportPoint(hrp.Position)
                    local headPos = Cam:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                    if onScreen then
                        local height = math.abs(pos.Y - headPos.Y) * 2.2
                        local width = height * 0.6
                        local boxPos = Vector2.new(pos.X - width/2, pos.Y - height/2)
                        data.Box.Visible = Vars.ESPBox
                        data.Box.Size = Vector2.new(width, height)
                        data.Box.Position = boxPos
                        data.Name.Visible = Vars.ESPName
                        data.Name.Text = p.Name
                        data.Name.Position = Vector2.new(pos.X, boxPos.Y - 20)
                        if Vars.ESPHealth and hum then
                            data.Health.Visible = true
                            local hp = hum.Health / hum.MaxHealth
                            data.Health.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0)
                            data.Health.Size = Vector2.new(3, height*hp)
                            data.Health.Position = Vector2.new(boxPos.X - 6, boxPos.Y + height*(1-hp))
                        else
                            data.Health.Visible = false
                        end
                    else
                        data.Box.Visible = false; data.Name.Visible = false; data.Health.Visible = false
                    end
                else
                    data.Box.Visible = false; data.Name.Visible = false; data.Health.Visible = false
                end
            else
                data.Box.Visible = false; data.Name.Visible = false; data.Health.Visible = false
            end
        end
    end)
end)

